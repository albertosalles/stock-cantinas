# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de Stock Cantinas
#
# Copiar a .env.local y rellenar. Las que NO llevan prefijo NEXT_PUBLIC_ son de
# servidor y no deben llegar nunca al navegador.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ─── Añadidas en F2 · Seguridad (S2) ─────────────────────────────────────────

# Clave de servicio: se salta RLS. La usan SÓLO las rutas de login, para validar
# credenciales y firmar el token, y la de fijar PIN. No es una puerta trasera
# generalizada para escrituras.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secreto JWT del proyecto Supabase, con el que firmamos los tokens de acceso.
# TIENE QUE SER EL DEL MISMO PROYECTO que NEXT_PUBLIC_SUPABASE_URL, o PostgREST
# rechazará los tokens que emitamos. Quien lo tenga puede fabricarse el rol que
# quiera: no debe salir del servidor.
SUPABASE_JWT_SECRET=<jwt-secret>

# Contraseña del panel de administración.
ADMIN_PASSWORD=<contraseña>

# ─── Restos del MVP sin auth ─────────────────────────────────────────────────
# Se usan como valores de respaldo en inventario y TPV. Con el token de S2 la
# identidad ya no sale de aquí; quedan hasta que S3 termine de derivarla del
# token en todas las RPC.
NEXT_PUBLIC_EVENT_ID=<uuid-evento>
NEXT_PUBLIC_CANTINA_ID=<uuid-cantina>
NEXT_PUBLIC_APP_USER_ID=<uuid-usuario>

# ─── Stripe Terminal ─────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_test_...>
STRIPE_SECRET_KEY=<sk_test_...>

# Origen de la aplicación. Lo usa WebAuthn (S6): una passkey registrada en un
# dominio NO sirve en otro, así que si esto no coincide con la URL real, el
# acceso biométrico deja de funcionar. En producción, sin barra final.
NEXT_PUBLIC_APP_URL=https://<dominio>
